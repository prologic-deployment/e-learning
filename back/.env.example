# Copy to back/.env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/elearning_dev
# Set persistent random secrets before creating encrypted data or sessions.
JWT_SECRET=
ENCRYPTION_KEY=
# 32 random bytes encoded as base64. Keep stable across restarts and replicas.
# On a database with NO existing/pending authenticators: npm run auth:configure
# Otherwise restore the original key from your secrets manager/backup.
TOTP_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:4200
CACHE_ENABLED=false
# Seeder writes require explicit opt-in; NEVER enable this in production/staging.
SEED_ALLOW_WRITE=false
